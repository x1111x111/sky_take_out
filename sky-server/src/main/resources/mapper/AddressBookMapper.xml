<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.skyserver.mapper.AddressBookMapper">

    <select id="getById"
            resultType="com.example.skyserver.entity.AddressBook">

        select *
        from address_book
        where id = #{id}

    </select>
    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        insert into address_book
        (
        user_id,
        consignee,
        phone,
        province_name,
        city_name,
        district_name,
        detail
        )
        values
        (
        #{userId},
        #{consignee},
        #{phone},
        #{provinceName},
        #{cityName},
        #{districtName},
        #{detail}
        )

    </insert>

    <select id="list"
            resultType="com.example.skyserver.entity.AddressBook">

        select *
        from address_book
        where user_id = #{userId}
        order by id desc

    </select>
</mapper>