<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.skyserver.mapper.DishFlavorMapper">


    <!-- 根据菜品查询口味 -->
    <select id="getByDishId"
            resultType="com.example.skyserver.entity.DishFlavor">

        select *
        from dish_flavor

        where dish_id=#{dishId}

    </select>



    <!-- 新增口味 -->
    <insert id="insert">

        insert into dish_flavor
        (
        dish_id,
        name,
        value
        )

        values
        (
        #{dishId},
        #{name},
        #{value}
        )

    </insert>



    <!-- 删除口味 -->
    <delete id="deleteByDishId">
        delete from dish_flavor
        where dish_id = #{dishId}
    </delete>

    <delete id="deleteById">

        delete from dish_flavor
        where id=#{id}

    </delete>
<!--
    <delete id="deleteByDishId">

        delete from dish_flavor
        where dish_id = #{dishId}

    </delete>-->


</mapper>