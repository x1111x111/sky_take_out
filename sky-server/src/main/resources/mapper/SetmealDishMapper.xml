<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.skyserver.mapper.SetmealDishMapper">

    <insert id="insert">

        insert into setmeal_dish
        (
        setmeal_id,
        dish_id,
        name,
        price,
        copies
        )
        values
        (
        #{setmealId},
        #{dishId},
        #{name},
        #{price},
        #{copies}
        )

    </insert>

    <select id="getBySetmealId"
            resultType="com.example.skyserver.entity.SetmealDish">

        select *
        from setmeal_dish
        where setmeal_id = #{setmealId}

    </select>

    <delete id="deleteBySetmealId">

        delete from setmeal_dish
        where setmeal_id = #{setmealId}

    </delete>
</mapper>