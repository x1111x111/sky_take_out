<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.skyserver.mapper.CategoryMapper">


    <!-- 查询总数量 -->
    <select id="count" resultType="java.lang.Long">

        select count(*)
        from category

        <where>

            <if test="name != null and name != ''">
                and name like concat('%',#{name},'%')
            </if>

            <if test="type != null">
                and type = #{type}
            </if>

        </where>

    </select>



    <!-- 分页查询 -->
    <select id="pageQuery"
            resultType="com.example.skyserver.entity.Category">

        select *
        from category


        <where>

            <if test="name != null and name != ''">
                and name like concat('%',#{name},'%')
            </if>


            <if test="type != null">
                and type = #{type}
            </if>

        </where>


        order by sort asc


        limit #{offset},#{pageSize}

    </select>

    <update id="update">

        update category

        <set>

            <if test="name != null">
                name = #{name},
            </if>

            <if test="type != null">
                type = #{type},
            </if>

            <if test="sort != null">
                sort = #{sort},
            </if>

            update_time = now()

        </set>


        where id = #{id}

    </update>

    <delete id="deleteById">
        delete from category
        where id = #{id}
    </delete>

    <select id="listByType"
            resultType="com.example.skyserver.entity.Category">

        select *
        from category
        where type = #{type}
        and status = 1
        order by sort asc

    </select>
</mapper>