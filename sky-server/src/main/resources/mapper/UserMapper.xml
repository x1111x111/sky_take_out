<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.skyserver.mapper.UserMapper">
<select id="todayOrderCount"
        resultType="java.lang.Integer">

    select count(*)

    from orders

    where date(order_time)=curdate()

</select>


    <select id="getByOpenid"
            resultType="com.example.skyserver.entity.User">

        select *

        from user

        where openid = #{openid}

    </select>



    <insert id="insert"
            useGeneratedKeys="true"
            keyProperty="id">

        insert into user
        (
        openid,
        name,
        avatar,
        create_time
        )
        values
        (
        #{openid},
        #{name},
        #{avatar},
        now()
        )

    </insert>


</mapper>